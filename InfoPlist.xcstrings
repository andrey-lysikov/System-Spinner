    "NSLocationUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض Sun & Moon الشمس والقمر والطقس في موقعك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun & Moon zeigt die Sonne, den Mond und das Wetter an Ihrem Standort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun & Moon shows the sun, the moon and the weather where you are."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun & Moon affiche le soleil, la lune et la météo là où vous vous trouvez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun & Moon mostra il sole, la luna e il meteo nel luogo in cui ti trovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun & Moon は、現在地の太陽、月、天気を表示します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun & Moon показывает солнце, луну и погоду там, где вы находитесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sun & Moon 会显示你所在位置的太阳、月亮和天气。"
          }
        }
      }
    },
